        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#00897B;strokeWidth=3;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="foundvnet" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell>


      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Hub &amp; Spoke Landing Zone — classic peering, central Azure Firewall, forced egress" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="16" width="960" height="30" as="geometry"/></mxCell>


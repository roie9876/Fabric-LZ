        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#43A047;strokeWidth=3;endArrow=classic;flowAnimation=1;" edge="1" parent="1" source="b_squid" target="b_net"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3l" value="iptables MASQUERADE + Squid URL filtering/logging" style="text;html=1;fontSize=10;fontColor=#43A047;" vertex="1" parent="1"><mxGeometry x="800" y="540" width="300" height="20" as="geometry"/></mxCell>

        <mxCell id="swap" value="Same contract, one swap point:&#10;spoke UDR default route → egress NVA private IP.&#10;Set egress_nva_private_ip = Squid VM in the lab,&#10;= Zscaler Cloud Connector ILB in production." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1300" y="470" width="290" height="150" as="geometry"/></mxCell>

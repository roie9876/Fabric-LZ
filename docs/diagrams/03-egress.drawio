        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#43A047;strokeWidth=3;endArrow=classic;flowAnimation=1;" edge="1" parent="1" source="b_wl" target="b_fw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b1l" value="UDR 0/0 → FW" style="text;html=1;fontSize=10;fontColor=#43A047;" vertex="1" parent="1"><mxGeometry x="205" y="540" width="140" height="20" as="geometry"/></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#43A047;strokeWidth=3;endArrow=classic;flowAnimation=1;" edge="1" parent="1" source="b_fw" target="b_squid"><mxGeometry relative="1" as="geometry"/></mxCell>

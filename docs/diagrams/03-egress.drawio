<mxfile host="app.diagrams.net">
  <diagram name="Egress" id="egr-1">
    <mxGraphModel dx="1422" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Forced Egress — production (Zscaler) vs. lab mimic (self-hosted proxy)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="16" width="1000" height="30" as="geometry"/></mxCell>

        <!-- lane A -->
        <mxCell id="laneA" value="Production (regulated enterprise)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fillColor=#eaf2fb;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1540" height="300" as="geometry"/></mxCell>
        <mxCell id="a_wl" value="Spoke workload" style="image;html=1;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;align=center;fontSize=11;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="a_fw" value="Azure Firewall" style="image;html=1;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;align=center;fontSize=11;image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="a_zcc" value="Zscaler Cloud Connector&#10;(NVA in egress subnet)" style="image;html=1;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;align=center;fontSize=11;image=img/lib/azure2/other/API_Proxy.svg;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="a_zcloud" value="Zscaler Cloud (ZIA)" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="a_net" value="Internet" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="180" width="180" height="110" as="geometry"/></mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078D4;strokeWidth=3;endArrow=classic;flowAnimation=1;" edge="1" parent="1" source="a_wl" target="a_fw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1l" value="UDR 0/0 → FW" style="text;html=1;fontSize=10;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="205" y="180" width="140" height="20" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078D4;strokeWidth=3;endArrow=classic;flowAnimation=1;" edge="1" parent="1" source="a_fw" target="a_zcc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2l" value="UDR 0/0 → egress NVA IP" style="text;html=1;fontSize=10;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="475" y="180" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078D4;strokeWidth=3;endArrow=classic;flowAnimation=1;" edge="1" parent="1" source="a_zcc" target="a_zcloud"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078D4;strokeWidth=3;endArrow=classic;flowAnimation=1;" edge="1" parent="1" source="a_zcloud" target="a_net"><mxGeometry relative="1" as="geometry"/></mxCell>


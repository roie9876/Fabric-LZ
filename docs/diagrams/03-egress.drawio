        <mxCell id="laneB" value="Your lab (no Zscaler license)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fillColor=#eafaf0;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="1540" height="300" as="geometry"/></mxCell>

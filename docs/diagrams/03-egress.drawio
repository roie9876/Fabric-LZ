        <mxCell id="b_fw" value="Azure Firewall" style="image;html=1;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;align=center;fontSize=11;image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="54" height="54" as="geometry"/></mxCell>
